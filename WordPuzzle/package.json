{
  "name": "word-puzzle-mobile",
  "version": "1.0.0",
  "scripts": {
    "version:bump": "node bump-version.js",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev-build": "cd android && gradlew assembleRelease",
    "prod-build": "npm run version:bump && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/cli": "latest",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-build-properties": "~0.14.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "fs": "^0.0.1-security",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-google-mobile-ads": "^14.3.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true
}
